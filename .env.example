# Path to the kicad-cli binary (required for KiCad export operations)
KICAD_CLI_PATH=/Applications/KiCad/KiCad.app/Contents/MacOS/kicad-cli

# Path to ngspice binary (optional, defaults to 'ngspice' on PATH)
NGSPICE_PATH=ngspice

# OpenRouter API key (required for LLM-based prompt runner)
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# OpenRouter base URL (optional, defaults to https://openrouter.ai/api/v1)
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Sentence-transformer model for datasheet embeddings (optional, defaults to all-MiniLM-L6-v2)
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
