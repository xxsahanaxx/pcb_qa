      \"confidence\": 0.45\n    },\n    {\n      \"category\": \"wrong_value\",\n      \"components\": [\"C14\", \"R2\"],\n      \"pins\": [\"C14.1\", \"C14.2\", \"R2.1\", \"R2.2\", \"U4.8\"],\n      \"nets\": [\"Net-(U4-EN{slash}CHIP_PU)\"],\n      \"observed\": \"The ESP32 EN network uses a 10uF capacitor (C14) with a 10k pull-up (R2).\",\n      \"expected\": \"The usual ESP32-C3 EN RC reset network is a 10k pull-up with about 0.1\u20131uF to GND. A 10uF value gives a much longer power-on hold time than is normal.\",\n      \"evidence\": [\n        {\"source\": \"netlist\", \"quote\": \"(comp (ref \\\"C14\\\") (value \\\"10uF\\\")\"},\n        {\"source\": \"netlist\", \"quote\": \"(net (code \\\"28\\\") (name \\\"Net-(U4-EN{slash}CHIP_PU)\\\")\"}\n      ],\n      \"impact\": \"Slow reset/enable rise at power-up. This is probably functional but may be a mis-set value.\",\n      \"confidence\": 0.15\n    }\n  ],\n  \"summary\": \"The netlist shows the heater switch OUT on J10 pin 2 while J6 pin 2 (which the specification names as the heater connector) sits on the GPIO1 control net, a likely miswiring. The EN-pin 10uF capacitor is a weaker, lower-confidence suspect.\"\n}",
